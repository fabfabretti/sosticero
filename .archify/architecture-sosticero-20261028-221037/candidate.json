  "cards": [
    {
      "dot": "emerald",
      "title": "Backend modules",
      "items": [
        "main.py: one factory builds every route, the dataset/state loaders and the write transaction helpers",
        "domain.py: rows, candidates, consultation, permit and assignment validation",
        "timetables.py + overrides.py + receptions.py: dated versions, dated hour patches, XLSX receptions",
        "recovery.py + paid.py + availability.py: permit ledger, banca ore, on-paper availability",
        "statistics.py, concurrency.py, backup.py, attachments.py, teacher_names.py, hour_types.py",
        "inbox.py registers /api/inbox* and polls the form sheet on a lifespan task"
      ]
    },
    {
      "dot": "cyan",
      "title": "Frontend views → endpoints",
      "items": [
        "Supplenze: GET /api/day/{day}, /api/candidates, /api/availability; POST /api/entries, /api/assignments",
        "Permessi: GET /api/permessi; POST /api/permessi, /api/manual-permits",
        "Banca ore: GET/POST /api/paid-availability; GET /api/stats/availability",
        "Orari: GET /api/orari, /api/receptions; POST /api/timetable, /api/orari/override, /api/orari/name",
        "Stats: GET /api/stats; Settings: /api/hour-types, /api/import|export, /api/backups*",
        "Inbox: GET /api/inbox*, POST /api/inbox/{id}/{accept|ignore|preview}; every view re-reads quietly every 15 s"
      ]
    },
    {
      "dot": "violet",
      "title": "Key domains",
      "items": [
        "Substitutions: cover rows per class-period, fixed candidate tiers (compresenza → other campus → recovery → exceptional)",
        "Permits: dated leave per period, optional request date, planned/last-minute, one-month recovery window clamped to month end",
        "Banca ore: paid availability per weekday plus assignment-derived recovery accounting",
        "Availability: capacity on paper from timetables and hour-type rules, never from the day's absences",
        "Campuses: Centrale / Succursale drive candidate ranking, travel rules, stats filters, PDF sheets and write permissions"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & data safety",
      "items": [
        "Single session cookie (HttpOnly, SameSite=Lax, Secure behind HTTPS) plus a CSRF header on every POST",
        "Host/origin check from APP_ORIGIN; non-Centrale accounts cannot call hour-types, timetable, import or restore",
        "Data generation header: 428 when missing, 409 when the dataset was replaced; per-record digests give 409 on stale edits",
        "GET /api/display is the only public API: today's assigned substitutes and class entry/exit times, nothing else",
        "Testing mode refuses the operational directory via the .sosticero-production marker",
        "SQLite WAL, 15 s busy timeout, 503 on a busy database; import and restore take a snapshot first"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime & deployment",
      "items": [
        "Dockerfile: Node builds frontend/dist, Python image runs uvicorn --factory on :8000 as a non-root user",
        "compose.server.yaml: no published port, read-only rootfs, dropped caps, 1 CPU / 1 GiB, only the proxy network",
        "scripts/deploy.sh builds on atlante, snapshots data, swaps only the sosticero container, verifies over HTTPS",
        "launcher.py is the second host: same factory, data beside the executable, random free port, opens the browser"
      ]
    },
    {
      "dot": "slate",
      "title": "Deliberate omissions",
      "items": [
        "No ORM and no migrations: the whole dataset and state are JSON documents with in-place shape upgrades",
        "No queue, worker or scheduler: the only background work is the inbox poll and the startup backup",
        "No external identity provider and no relational history tables",
        "Not shown: the deploy host atlante, test-only compose.testing.yaml, and per-file module boundaries"
      ]
    }
  ]
}