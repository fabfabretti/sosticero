  "cards": [
    {
      "dot": "cyan",
      "title": "API surface by group",
      "items": [
        "Planner: GET /api/day/{day}, /api/candidates, /api/availability; POST /api/entries, /api/assignments, /api/display",
        "Permits: GET /api/permessi; POST /api/permessi, /api/manual-permits",
        "Banca ore: GET/POST /api/paid-availability; GET /api/stats/availability",
        "Timetable: GET /api/orari, /api/receptions; POST /api/orari/preview, /api/orari/override, /api/orari/name, /api/timetable[/preview], /api/receptions[/preview]",
        "Reporting: GET /api/stats with campus, period and date range; GET /api/export (JSON archive)",
        "Settings & Inbox: /api/hour-types, /api/import[/preview], /api/backups[/restore], /api/attachments/{id}, /api/inbox*"
      ]
    },
    {
      "dot": "emerald",
      "title": "Modules not drawn as nodes",
      "items": [
        "storage.py: Store.read/write over documents, WAL, 15 s busy timeout; one connection per request block",
        "concurrency.py: sha256 digest per record, expected map → 409 record_changed, missing → 428 precondition_required",
        "backup.py: sqlite backup API snapshot before every import and restore, prune to 10 files / 7 days",
        "attachments.py: BLOB rows, pruned whenever state is saved; served only when referenced by state",
        "auth.py: accounts, argon2 hashes, 12 h sessions, generation counter bumped on import/restore",
        "display.py: the only public projection, built from today's assignments"
      ]
    },
    {
      "dot": "violet",
      "title": "Write path, in order",
      "items": [
        "1. Gate validates cookie, CSRF and X-Data-Generation, then applies the campus policy for the route",
        "2. Handler opens a connection and runs BEGIN IMMEDIATE (write) or BEGIN (read)",
        "3. load() assembles the dataset version for the day and defaults every state group",
        "4. concurrency.check(expected, snapshot, keys) rejects a stale form with 409 before any mutation",
        "5. The rule module validates the new value; ValueError becomes 422 and nothing is written",
        "6. save_state() re-syncs statistics for the touched days, writes state, prunes attachments, commits"
      ]
    },
    {
      "dot": "amber",
      "title": "Document keys",
      "items": [
        "dataset: imported teachers, classes and weekly lessons (the baseline before any version)",
        "state: abs · cf · dis · disSites · asg · permessi · permitIds · manualPermits · paidAvailability and their notes/kinds/attachments",
        "timetables: dated versions plus the merged overrides and receptions documents",
        "statistics: per-day outcomes (covered, uncovered, late, early, pending) rebuilt from state and timetable",
        "hourTypes and teacherNameOverrides: policy per hour code, presentation-only renaming",
        "attachments: id, media type, bytes; nothing is served unless state still references it"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards that shape behaviour",
      "items": [
        "Import and restore need confirm=true and the preview token; a new backup is taken first",
        "Generation mismatch returns 409 dataset_replaced so a stale tab cannot overwrite an import",
        "Non-Centrale accounts get 403 on hour-types, timetable, import, backups and inbox configuration",
        "sqlite3.OperationalError surfaces as 503 with no partial write; testing mode refuses the operational directory",
        "Every response carries X-Data-Generation and Cache-Control: no-store"
      ]
    }
  ]
}
